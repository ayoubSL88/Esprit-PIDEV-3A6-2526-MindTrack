{% extends 'layouts/front_base.html.twig' %}

{% block page_title %}Exercices{% endblock %}

{% block content %}
    <div class="mt-exercises-shell">
        <header class="mt-page-header">
            <div>
                <p class="mt-section-kicker">MindTrack / Exercices</p>
                <h1>Exercices</h1>
            </div>

            <div class="mt-header-actions">
                <div class="mt-count-badge">
                    <i class="bi bi-journal-text"></i>
                    {{ exercices|length }} exercices
                </div>
                <a href="{{ path('front_gestion_exercices_home') }}" class="mt-button mt-button-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Retour
                </a>
            </div>
        </header>

        <div class="mt-toolbar">
            <form method="get" class="mt-search-form" role="search" aria-label="Recherche d'exercices">
                <div class="mt-search-field">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" name="search" value="{{ search }}" placeholder="Rechercher un exercice, une catégorie ou un thème..." aria-label="Recherche des exercices">
                </div>
                <button class="mt-submit-button" type="submit" aria-label="Lancer la recherche">
                    Rechercher
                </button>
            </form>

            <form method="get" class="mt-filter-form" aria-label="Filtrer les exercices">
                {% if search %}
                    <input type="hidden" name="search" value="{{ search }}">
                {% endif %}
                <div class="mt-filter-field">
                    <label for="difficulte" class="sr-only">Difficulté</label>
                    <select id="difficulte" name="difficulte" onchange="this.form.submit()" aria-label="Filtrer par difficulté">
                        <option value="" {% if not difficulte %}selected{% endif %}>Toutes les difficultés</option>
                        <option value="FACILE" {% if difficulte == 'FACILE' %}selected{% endif %}>Facile</option>
                        <option value="MOYEN" {% if difficulte == 'MOYEN' %}selected{% endif %}>Moyen</option>
                        <option value="DIFFICILE" {% if difficulte == 'DIFFICILE' %}selected{% endif %}>Difficile</option>
                    </select>
                </div>
            </form>
        </div>

        <div class="mt-summary-row">
            <div class="mt-summary-card">
                <div class="label"><i class="bi bi-collection"></i> Total</div>
                <div class="value">{{ exercices.getTotalItemCount() ?? exercices|length }}</div>
                <div class="meta">exercices disponibles</div>
            </div>
            <div class="mt-summary-card">
                <div class="label"><i class="bi bi-check2-circle"></i> Faciles</div>
                <div class="value">{{ exercices|filter(exercice => exercice.difficulte == 'FACILE')|length }}</div>
                <div class="meta">niveau débutant</div>
            </div>
            <div class="mt-summary-card">
                <div class="label"><i class="bi bi-activity"></i> Moyens</div>
                <div class="value">{{ exercices|filter(exercice => exercice.difficulte == 'MOYEN')|length }}</div>
                <div class="meta">niveau intermédiaire</div>
            </div>
            <div class="mt-summary-card">
                <div class="label"><i class="bi bi-flame"></i> Difficiles</div>
                <div class="value">{{ exercices|filter(exercice => exercice.difficulte == 'DIFFICILE')|length }}</div>
                <div class="meta">niveau avancé</div>
            </div>
        </div>

        {% if exercices is empty %}
            <div class="mt-empty-state">
                <div>
                    <div class="mt-empty-icon"><i class="bi bi-clipboard-x"></i></div>
                    <h3>Aucun exercice trouvé</h3>
                    <p>Essayez une autre recherche ou réinitialisez les filtres pour retrouver l'ensemble des exercices.</p>
                    <a href="{{ path('front_gestion_exercices_index') }}" class="mt-button mt-button-primary">Voir tous les exercices</a>
                </div>
            </div>
        {% else %}
            <div class="mt-exercises-grid">
                {% for exercice in exercices %}
                    {% set difficultyClass = 'mt-badge-facile' %}
                    {% if exercice.difficulte == 'MOYEN' %}
                        {% set difficultyClass = 'mt-badge-moyen' %}
                    {% elseif exercice.difficulte == 'DIFFICILE' %}
                        {% set difficultyClass = 'mt-badge-difficile' %}
                    {% endif %}

                    <article class="mt-exercise-card">
                        <div class="mt-card-top">
                            <div class="mt-icon-badge"><i class="bi bi-journal-text"></i></div>
                            <span class="mt-badge {{ difficultyClass }}">{{ exercice.difficulte|capitalize }}</span>
                        </div>

                        <h2>{{ exercice.nom }}</h2>
                        <p>{{ exercice.description|length > 125 ? exercice.description|slice(0, 125) ~ '...' : exercice.description }}</p>

                        <div class="mt-card-tags">
                            <span class="mt-tag"><i class="bi bi-tag"></i> {{ exercice.type }}</span>
                            <span class="mt-tag"><i class="bi bi-calendar3"></i> {{ exercice.dateCreation ? exercice.dateCreation|date('d/m/Y') : 'N/A' }}</span>
                        </div>

                        <div class="mt-progress-box">
                            <div class="mt-progress-meta">
                                <span>Progression</span>
                                <span>72%</span>
                            </div>
                            <div class="mt-progress-track" aria-label="Progression de l'exercice">
                                <span class="mt-progress-fill" style="width: 72%"></span>
                            </div>
                        </div>

                        <div class="mt-card-footer">
                            <div class="mt-mini-meta"><i class="bi bi-clock-history"></i> {{ exercice.duree }} min</div>
                            <a class="mt-button mt-button-primary" href="{{ path('front_gestion_exercices_show', {'idEx': exercice.idEx}) }}">
                                Continuer
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}