{% set captchaVerified = captcha_verified|default(false) %}

<div class="captcha-widget" data-captcha-widget data-captcha-context="{{ context }}" data-captcha-verified="{{ captchaVerified ? '1' : '0' }}">
    <p class="captcha-success rounded-2xl border border-success-border bg-success-soft px-3 py-2 text-xs text-success {% if not captchaVerified %}hidden{% endif %}" data-captcha-success-message>
        CAPTCHA valid.
    </p>

<section class="captcha-shell grid gap-3 rounded-2xl border border-border bg-white/85 p-3 shadow-soft {% if captchaVerified %}hidden{% endif %}" data-captcha-shell>
    <div class="space-y-1">
        <p class="text-xs font-semibold text-ink">Security check</p>
        <p class="text-xs text-muted">Verify the code before submitting.</p>
    </div>

    <div class="captcha-fields grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center" data-captcha-fields {% if captchaVerified %}hidden{% endif %}>
        <img
            src="{{ path('app_captcha_image', {context: context}) }}?v={{ random() }}"
            alt="CAPTCHA challenge"
            id="{{ context }}-captcha-image"
            class="captcha-image h-16 w-full rounded-xl border border-border bg-slate-50 object-cover"
            data-captcha-image
        >
        <div class="captcha-actions grid grid-cols-2 gap-2 sm:grid-cols-1">
            <button
                type="button"
                class="btn-secondary btn-sm justify-center"
                data-captcha-refresh
                data-captcha-refresh-url="{{ path('app_captcha_refresh', {context: context}) }}"
                data-captcha-image-url="{{ path('app_captcha_image', {context: context}) }}"
                data-captcha-target="{{ context }}-captcha-image"
            >
                Refresh CAPTCHA
            </button>
            <button
                type="button"
                class="btn-primary btn-sm justify-center"
                data-captcha-verify
                data-captcha-verify-url="{{ path('app_captcha_verify', {context: context}) }}"
            >
                Verify CAPTCHA
            </button>
        </div>
    </div>

    <div class="field captcha-input" data-captcha-input-wrap {% if captchaVerified %}hidden{% endif %}>
        <label class="field-label text-xs" for="{{ context }}_captcha">CAPTCHA</label>
        <input
            class="field-input {{ fieldErrors.captcha is defined ? 'field-input-invalid' : '' }}"
            type="text"
            id="{{ context }}_captcha"
            name="captcha"
            value="{{ form.captcha|default('') }}"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            maxlength="6"
            data-captcha-input
        >
        <input type="hidden" name="captcha_verified" value="{{ captchaVerified ? '1' : '0' }}" data-captcha-verified-input>
        <input type="hidden" value="{{ csrf_token('captcha_verify_' ~ context) }}" data-captcha-csrf>
        {% if fieldErrors.captcha is defined %}
            <p class="field-error">{{ fieldErrors.captcha }}</p>
        {% endif %}
    </div>

</section>
</div>
