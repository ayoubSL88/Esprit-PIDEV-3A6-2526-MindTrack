<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inscription — MindTrack</title>
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><rect width='128' height='128' rx='32' fill='%236366f1'/><text x='64' y='88' font-size='72' font-weight='bold' fill='white' text-anchor='middle'>MT</text></svg>">
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="{{ asset('build/design-system.css') }}">
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
</head>
<body style="min-height: 100vh; display: flex; flex-direction: column;">
    
    <!-- Header -->
    <header style="position: fixed; width: 100%; top: 0; background: var(--surface-primary); z-index: var(--z-fixed); border-bottom: 1px solid var(--border-light);">
        <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem;">
            <a href="{{ path('front_home') }}" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;">
                <div style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--brand-500), var(--brand-600)); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: var(--text-sm);">
                    MT
                </div>
                <span style="font-size: var(--text-lg); font-weight: 600; color: var(--text-primary);">MindTrack</span>
            </a>
            
            <!-- Theme Toggle -->
            <button class="btn btn-ghost btn-icon" id="theme-toggle" aria-label="Changer le thème">
                <i class="bi bi-sun" id="theme-icon-light"></i>
                <i class="bi bi-moon" id="theme-icon-dark" style="display: none;"></i>
            </button>
        </div>
    </header>
    
    <!-- Main Content -->
    <main style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 5rem 2rem 2rem;">
        <div style="width: 100%; max-width: 560px;">
            
            <!-- Card -->
            <div class="card" style="padding: 0;">
                <div class="card-body" style="padding: 2.5rem;">
                    
                    <!-- Header -->
                    <div style="text-align: center; margin-bottom: 2rem;">
                        <div style="width: 4rem; height: 4rem; background: linear-gradient(135deg, var(--success-500), var(--success-600)); border-radius: var(--radius-xl); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
                            <i class="bi bi-person-plus" style="font-size: 2rem; color: white;"></i>
                        </div>
                        <h1 style="font-size: var(--text-2xl); font-weight: 700; margin: 0 0 0.5rem 0;">Créer un compte</h1>
                        <p style="font-size: var(--text-sm); color: var(--text-secondary); margin: 0;">
                            Rejoignez MindTrack et commencez votre voyage
                        </p>
                    </div>
                    
                    <!-- Flash Messages -->
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
                            <div class="alert-icon"><i class="bi bi-exclamation-circle"></i></div>
                            <div class="alert-message">{{ message }}</div>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success" style="margin-bottom: 1.5rem;">
                            <div class="alert-icon"><i class="bi bi-check-circle"></i></div>
                            <div class="alert-message">{{ message }}</div>
                        </div>
                    {% endfor %}
                    
                    <!-- Register Form -->
                    <form method="post" style="margin-bottom: 1.5rem;">
                        
                        <!-- Name Row -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                <label for="nom" class="form-label">Nom</label>
                                <input 
                                    type="text" 
                                    id="nom" 
                                    name="nom" 
                                    class="form-input {% if formSubmitted and fieldErrors.nom is defined %}form-input-error{% endif %}"
                                    value="{{ form.nom|default('') }}"
                                    placeholder="Dupont"
                                    required
                                >
                                {% if fieldErrors.nom is defined %}
                                    <p class="form-error">{{ fieldErrors.nom }}</p>
                                {% endif %}
                            </div>
                            
                            <div class="form-group">
                                <label for="prenom" class="form-label">Prénom</label>
                                <input 
                                    type="text" 
                                    id="prenom" 
                                    name="prenom" 
                                    class="form-input {% if formSubmitted and fieldErrors.prenom is defined %}form-input-error{% endif %}"
                                    value="{{ form.prenom|default('') }}"
                                    placeholder="Jean"
                                    required
                                >
                                {% if fieldErrors.prenom is defined %}
                                    <p class="form-error">{{ fieldErrors.prenom }}</p>
                                {% endif %}
                            </div>
                        </div>
                        
                        <!-- Email & Age Row -->
                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                <label for="email" class="form-label">
                                    <i class="bi bi-envelope"></i> Email
                                </label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email" 
                                    class="form-input {% if formSubmitted and fieldErrors.email is defined %}form-input-error{% endif %}"
                                    value="{{ form.email|default('') }}"
                                    placeholder="votre@email.com"
                                    required
                                >
                                {% if fieldErrors.email is defined %}
                                    <p class="form-error">{{ fieldErrors.email }}</p>
                                {% endif %}
                            </div>
                            
                            <div class="form-group">
                                <label for="age" class="form-label">Âge</label>
                                <input 
                                    type="number" 
                                    id="age" 
                                    name="age" 
                                    class="form-input {% if formSubmitted and fieldErrors.age is defined %}form-input-error{% endif %}"
                                    value="{{ form.age|default('') }}"
                                    placeholder="25"
                                    min="13"
                                    max="120"
                                    required
                                >
                                {% if fieldErrors.age is defined %}
                                    <p class="form-error">{{ fieldErrors.age }}</p>
                                {% endif %}
                            </div>
                        </div>
                        
                        <!-- Password -->
                        <div class="form-group">
                            <label for="password" class="form-label">
                                <i class="bi bi-lock"></i> Mot de passe
                            </label>
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                class="form-input {% if formSubmitted and fieldErrors.password is defined %}form-input-error{% endif %}"
                                placeholder="••••••••"
                                required
                            >
                            <p class="form-helper">Minimum 8 caractères</p>
                            {% if fieldErrors.password is defined %}
                                <p class="form-error">{{ fieldErrors.password }}</p>
                            {% endif %}
                        </div>
                        
                        <!-- CSRF Token -->
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
                        
                        <!-- Submit -->
                        <button type="submit" class="btn btn-success btn-lg" style="width: 100%; margin-top: 1rem;">
                            <i class="bi bi-person-plus"></i>
                            Créer mon compte
                        </button>
                    </form>
                    
                    <!-- Divider -->
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
                        <div style="flex: 1; height: 1px; background: var(--border-light);"></div>
                        <span style="font-size: var(--text-xs); color: var(--text-muted); text-transform: uppercase;">ou</span>
                        <div style="flex: 1; height: 1px; background: var(--border-light);"></div>
                    </div>
                    
                    <!-- Social Register -->
                    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
                        <a href="{{ path('app_connect_google') }}" class="btn btn-secondary" style="width: 100%;">
                            <svg style="width: 1rem; height: 1rem;" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            Continuer avec Google
                        </a>
                        <a href="{{ path('app_connect_github') }}" class="btn btn-secondary" style="width: 100%;">
                            <i class="bi bi-github"></i>
                            Continuer avec GitHub
                        </a>
                    </div>
                    
                    <!-- Login Link -->
                    <div style="text-align: center; padding-top: 1.5rem; border-top: 1px solid var(--border-light);">
                        <p style="font-size: var(--text-sm); color: var(--text-secondary); margin: 0;">
                            Déjà un compte ?
                            <a href="{{ path('app_login') }}" style="color: var(--brand-500); font-weight: 500;">
                                Se connecter
                            </a>
                        </p>
                    </div>
                    
                </div>
            </div>
            
        </div>
    </main>
    
    <!-- Footer -->
    <footer style="padding: 1.5rem; text-align: center; border-top: 1px solid var(--border-light);">
        <p style="font-size: var(--text-xs); color: var(--text-muted); margin: 0;">
            &copy; {{ "now"|date("Y") }} MindTrack. Tous droits réservés.
        </p>
    </footer>
    
    <script>
    // Theme Toggle
    (function() {
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;
        const themeIconLight = document.getElementById('theme-icon-light');
        const themeIconDark = document.getElementById('theme-icon-dark');
        
        // Load saved theme
        const savedTheme = localStorage.getItem('theme') || 'light';
        if (savedTheme === 'dark') {
            html.setAttribute('data-theme', 'dark');
            themeIconLight.style.display = 'none';
            themeIconDark.style.display = 'block';
        }
        
        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                
                if (newTheme === 'dark') {
                    themeIconLight.style.display = 'none';
                    themeIconDark.style.display = 'block';
                } else {
                    themeIconLight.style.display = 'block';
                    themeIconDark.style.display = 'none';
                }
            });
        }
    })();
    </script>

    <script>
    /* CAPTCHA Widget JS */
    (() => {
        const init = () => {
        document.querySelectorAll('[data-captcha-widget]').forEach((widget) => {
            const shell = widget.querySelector('[data-captcha-shell]');
            const successMessage = widget.querySelector('[data-captcha-success-message]');
            const refreshButton = widget.querySelector('[data-captcha-refresh]');
            const verifyButton = widget.querySelector('[data-captcha-verify]');
            const image = widget.querySelector('[data-captcha-image]');
            const fields = widget.querySelector('[data-captcha-fields]');
            const inputWrap = widget.querySelector('[data-captcha-input-wrap]');
            const input = widget.querySelector('[data-captcha-input]');
            const verifiedInput = widget.querySelector('[data-captcha-verified-input]');
            const csrfField = widget.querySelector('[data-captcha-csrf]');

            if (!shell || !successMessage || !refreshButton || !verifyButton || !image || !fields || !inputWrap || !input || !verifiedInput || !csrfField) { return; }

            const setSuccessState = (message) => { shell.classList.add('hidden'); successMessage.classList.remove('hidden'); successMessage.textContent = message; verifiedInput.value = '1'; };
            const setDefaultState = () => { shell.classList.remove('hidden'); successMessage.classList.add('hidden'); verifiedInput.value = '0'; };

            if (widget.getAttribute('data-captcha-verified') === '1') { setSuccessState('CAPTCHA valid.'); } else { setDefaultState(); }

            refreshButton.addEventListener('click', async () => {
                const refreshUrl = refreshButton.getAttribute('data-captcha-refresh-url');
                const imageUrl = refreshButton.getAttribute('data-captcha-image-url');
                const targetId = refreshButton.getAttribute('data-captcha-target');
                const targetImage = targetId ? document.getElementById(targetId) : image;
                if (!refreshUrl || !imageUrl || !targetImage) { return; }
                refreshButton.disabled = true;
                try {
                    const response = await fetch(refreshUrl, { method: 'POST', headers: { 'Accept': 'application/json' } });
                    if (!response.ok) { throw new Error('Refresh failed.'); }
                    const data = await response.json();
                    targetImage.src = data.imageUrl;
                    input.value = '';
                    setDefaultState();
                } catch (_) {
                    targetImage.src = `${imageUrl}?v=${Date.now()}`;
                } finally { refreshButton.disabled = false; }
            });

            verifyButton.addEventListener('click', async () => {
                const verifyUrl = verifyButton.getAttribute('data-captcha-verify-url');
                const value = input.value.trim();
                if (!verifyUrl) { return; }
                if (value === '') { setDefaultState(); return; }
                verifyButton.disabled = true; refreshButton.disabled = true;
                try {
                    const response = await fetch(verifyUrl, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: new URLSearchParams({ captcha: value, _csrf_token: csrfField.value })
                    });
                    const data = await response.json();
                    if (!response.ok || !data.valid) {
                        if (data.imageUrl) { image.src = data.imageUrl; }
                        input.value = '';
                        setDefaultState();
                        return;
                    }
                    setSuccessState(data.message || 'CAPTCHA valid.');
                } catch (_) {
                    setDefaultState();
                } finally { verifyButton.disabled = false; refreshButton.disabled = false; }
            });
        });
        };
        if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init, { once: true }); } else { init(); }
    })();
    </script>
</body>
</html>
