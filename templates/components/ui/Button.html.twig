{#
    Button Component
    
    Usage:
    {% include 'components/ui/Button.html.twig' with {
        variant: 'primary'|'secondary'|'outline'|'ghost'|'success'|'warning'|'danger',
        size: 'xs'|'sm'|'md'|'lg'|'xl',
        icon: 'bi-plus',
        icon_only: false,
        href: '/path',  # optional, renders as <a> instead of <button>
        type: 'button'|'submit'|'reset',
        disabled: false,
        class: 'additional-classes',
        attributes: { 'data-testid': 'my-button' }
    } %}
    Button Text
    {% endinclude %}
#}

{% set variant = variant|default('primary') %}
{% set size = size|default('md') %}
{% set icon_only = icon_only|default(false) %}
{% set disabled = disabled|default(false) %}
{% set type = type|default('button') %}
{% set class = class|default('') %}

{% set base_classes = 'btn' %}

{% set variant_classes = {
    'primary': 'btn-primary',
    'secondary': 'btn-secondary',
    'outline': 'btn-outline',
    'ghost': 'btn-ghost',
    'success': 'btn-success',
    'warning': 'btn-warning',
    'danger': 'btn-danger'
} %}

{% set size_classes = {
    'xs': 'btn-xs',
    'sm': 'btn-sm',
    'md': '',
    'lg': 'btn-lg',
    'xl': 'btn-xl'
} %}

{% set icon_size_classes = {
    'xs': 'btn-icon btn-xs',
    'sm': 'btn-icon btn-sm',
    'md': 'btn-icon',
    'lg': 'btn-icon btn-lg',
    'xl': 'btn-icon btn-lg'
} %}

{% set classes = base_classes ~ ' ' ~ variant_classes[variant] %}

{% if icon_only %}
    {% set classes = classes ~ ' ' ~ icon_size_classes[size] %}
{% else %}
    {% set classes = classes ~ ' ' ~ size_classes[size] %}
{% endif %}

{% if class %}
    {% set classes = classes ~ ' ' ~ class %}
{% endif %}

{% if href %}
    <a href="{{ href }}" class="{{ classes }}" {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %} {% for attr, value in attributes|default({}) %} {{ attr }}="{{ value }}"{% endfor %}>
        {% if icon %}
            <i class="bi {{ icon }}"></i>
        {% endif %}
        {% if not icon_only %}
            {{ block('content') }}
        {% endif %}
    </a>
{% else %}
    <button type="{{ type }}" class="{{ classes }}" {% if disabled %}disabled{% endif %} {% for attr, value in attributes|default({}) %} {{ attr }}="{{ value }}"{% endfor %}>
        {% if icon %}
            <i class="bi {{ icon }}"></i>
        {% endif %}
        {% if not icon_only %}
            {{ block('content') }}
        {% endif %}
    </button>
{% endif %}
