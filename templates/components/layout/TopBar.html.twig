{#
    TopBar Component
    
    Usage:
    {% include 'components/layout/TopBar.html.twig' with {
        title: 'Page Title',
        subtitle: 'Page subtitle',
        breadcrumbs: [
            { label: 'Home', path: 'front_home' },
            { label: 'Exercices', path: 'front_gestion_exercices_home' }
        ],
        office: 'front'|'admin'
    } %}
#}

{% set title = title|default('') %}
{% set subtitle = subtitle|default('') %}
{% set breadcrumbs = breadcrumbs|default([]) %}
{% set office = office|default('front') %}

<header class="top-nav">
    <div class="top-nav-inner">
        <!-- Mobile Menu Toggle -->
        <button class="btn btn-ghost btn-icon" id="sidebar-toggle" aria-label="Menu">
            <i class="bi bi-list"></i>
        </button>
        
        <!-- Breadcrumbs -->
        {% if breadcrumbs is not empty %}
        <nav class="breadcrumb" aria-label="Breadcrumb" style="display: flex; align-items: center; gap: 0.5rem;">
            {% for crumb in breadcrumbs %}
                {% if not loop.last %}
                    <a href="{{ path(crumb.path) }}" style="color: var(--brand-500); text-decoration: none; font-size: var(--text-sm);">
                        {{ crumb.label }}
                    </a>
                    <i class="bi bi-chevron-right" style="color: var(--text-muted); font-size: 0.75rem;"></i>
                {% else %}
                    <span style="color: var(--text-muted); font-size: var(--text-sm);">{{ crumb.label }}</span>
                {% endif %}
            {% endfor %}
        </nav>
        {% endif %}
        
        <!-- Page Title -->
        {% if title %}
        <div>
            <h1 style="font-size: var(--text-xl); font-weight: 600; margin: 0;">{{ title }}</h1>
            {% if subtitle %}
                <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0.25rem 0 0 0;">{{ subtitle }}</p>
            {% endif %}
        </div>
        {% endif %}
        
        <!-- Right Side -->
        <div style="display: flex; align-items: center; gap: 1rem;">
            <!-- Theme Toggle (Desktop) -->
            <button class="btn btn-ghost btn-icon" id="theme-toggle-topbar" aria-label="Changer le thème" style="display: none;">
                <i class="bi bi-sun" id="theme-icon-light-topbar"></i>
                <i class="bi bi-moon" id="theme-icon-dark-topbar" style="display: none;"></i>
            </button>
            
            <!-- User Menu -->
            {% if app.user %}
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="text-align: right; display: none;" class="user-info-desktop">
                        <div style="font-size: var(--text-sm); font-weight: 500;">{{ app.user.nom ?? app.user.userIdentifier }}</div>
                        <div style="font-size: var(--text-xs); color: var(--text-muted);">{{ app.user.email }}</div>
                    </div>
                    <a href="{{ path('front_gestion_user_index') }}" class="btn btn-ghost btn-icon">
                        <i class="bi bi-person-circle" style="font-size: 1.25rem;"></i>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</header>

<style>
    @media (min-width: 1024px) {
        #sidebar-toggle {
            display: none;
        }
        
        .user-info-desktop {
            display: block !important;
        }
        
        #theme-toggle-topbar {
            display: inline-flex !important;
        }
    }
</style>
